# Copy to .dev.vars for local development (git-ignored).
# The operator/admin bearer token used by the dashboard.
ADMIN_TOKEN=dev-admin-token-change-me

# Optional: enable AI generation endpoints (one key is enough).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=anthropic   # or: openai (default: first key found)
# AI_MODEL=claude-sonnet-5  # or e.g. gpt-5-mini
