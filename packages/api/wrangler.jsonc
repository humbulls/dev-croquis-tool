{
  // Croquis runs as a single Worker: the API (/api/*), the remote MCP server
  // (/mcp) and the dashboard, share viewer and widget.js as static assets.
  // "Deploy to Cloudflare" provisions the D1 database and R2 bucket below.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "croquis",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "croquis",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "croquis-attachments" }],
  // Zero-configuration AI. Set ANTHROPIC_API_KEY or OPENAI_API_KEY to use those instead.
  "ai": { "binding": "AI", "remote": true },
  // Throttles the unauthenticated endpoints (widget, share links, sign-in).
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Webhook retries and housekeeping.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SIGNUP_MODE": "invite"
  }
}
