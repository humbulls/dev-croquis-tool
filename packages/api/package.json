{
  "name": "@croquis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Croquis API — Cloudflare Workers (Hono) + D1 + R2.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply croquis --local",
    "migrate:remote": "wrangler d1 migrations apply croquis --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@croquis/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.12.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260715.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
