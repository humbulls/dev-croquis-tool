{
  "name": "@croquis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Croquis API — Cloudflare Workers (Hono) + D1 + R2.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply croquis --local",
    "migrate:remote": "wrangler d1 migrations apply croquis --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@croquis/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0"
  }
}
