{
  "name": "@croquis/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Croquis \u2014 let Claude Code, Cursor and other agents read review feedback, fix it and report back.",
  "license": "MIT",
  "bin": {
    "croquis-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@croquis/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5",
    "@croquis/client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "import": "./src/tools.ts"
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "website-feedback",
    "design-review",
    "croquis"
  ]
}
