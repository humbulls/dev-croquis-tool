{
  "name": "@croquis/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Croquis domain contract: Zod schemas, types, constants, URL→page matching and the Markdown export.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./src/constants.ts"
    },
    "./url": {
      "types": "./src/url.ts",
      "import": "./src/url.ts"
    }
  },
  "scripts": {
    "build": "echo \"@croquis/shared: source package, no build step\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
